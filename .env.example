# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# OpenAI — used by the carousel/info-card doodle generator
OPENAI_API_KEY=sk-...

# Recraft — used by templates/freeform/ for hero illustrations (sparingly).
# Get a key from https://www.recraft.ai/ → API.
# Each generation costs ~40 credits (~$0.04). See templates/freeform/design.md for prompting principles.
RECRAFT_API_KEY=
